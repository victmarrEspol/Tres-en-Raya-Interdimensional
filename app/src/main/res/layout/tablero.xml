            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="28dp"
            android:background="#313244">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estás a punto de jugar contra Eyestree. Vino desde una dimensión donde las plantas reinan sobre el resto de seres vivos. Le gusta que las aves hagan nidos sobre él y tomar el sol. Va saltando de dimensión en dimensión, en busca de lentes de lectura. ''Es muy difícil cuando tienes 6 ojos...'' "
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginBottom="25dp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
