                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:layout_marginBottom="25dp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Elige tu símbolo"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/grupoSimbolo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="22dp">

                <RadioButton
                    android:id="@+id/opcionX"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="X"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginEnd="25dp" />

                <RadioButton
                    android:id="@+id/opcionO"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="O"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

            </RadioGroup>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Quién empieza?"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/grupoInicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="25dp">

                <RadioButton
                    android:id="@+id/opcionJugador"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yo"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />

                <RadioButton
                    android:id="@+id/opcionMaquina"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eyestree"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />

            </RadioGroup>


            <Button
